# Copy to .env for local development. On the host (Railway/Render), set these
# as environment variables instead — never commit real values.

NODE_ENV=production
# PORT is usually set by the host automatically
# PORT=3000

# Signs the admin login cookie. REQUIRED. Use a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# MySQL connection string, e.g. mysql://user:password@host:3306/dbname
DATABASE_URL=

# File storage (Cloudflare R2 shown; any S3-compatible bucket works)
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=inbetweenday-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional: public URL of the bucket (R2 public bucket or custom domain).
# If set, images are served straight from it (faster, cached).
# S3_PUBLIC_URL=https://media.inbetweenday.com

# Email (Resend)
RESEND_API_KEY=
SENDER_EMAIL=In-Between Days <newsletter@inbetweenday.com>

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Only for scripts/copy-storage.ts: where to download existing files from
# SOURCE_BASE_URL=https://inbetweenday.com
